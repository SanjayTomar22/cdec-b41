pipeline {
    agent any

    stages {
        stage('git-pull') {
            steps {
                git branch: 'main', url: 'https://github.com/SanjayTomar22/cdec-terraform.git'
            }
        }
        stage('init') {
            steps {
                sh 'terraform init'
            }
        }
        stage('plan') {
            steps {
                sh 'terraform plan'
            }
        }
        stage('Verify') {
            steps {
                timeout(10) {
                    input message: 'Shall we proceed ?', ok: 'Approve'
                }      
            }
        }
        stage('apply') {
            steps {
               sh 'terraform apply --auto-approve'
            }
        }
    }
}
